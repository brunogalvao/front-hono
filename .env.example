# Configuração do Supabase
# Obtenha em: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui
GEMINI_API_KEY=chave_gemini

# URL da API (api-hono)
# Em desenvolvimento: deixe comentado — o proxy do Vite redireciona automaticamente
# Em produção: defina a URL do deployment da api-hono no Vercel
# VITE_API_URL=https://api-hono-jet.vercel.app


# Convites de workspace (somente Edge Functions; nunca usar prefixo VITE_)
SITE_URL=http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=chave_anonima_local
SUPABASE_SERVICE_ROLE_KEY=chave_service_role_local
RESEND_API_KEY=chave_resend_de_teste
FROM_EMAIL=FinanceTask <noreply@example.test>
INVITE_RATE_LIMIT_ACTOR_WORKSPACE_PER_HOUR=10
INVITE_RATE_LIMIT_RECIPIENT_WORKSPACE_PER_HOUR=3
INVITE_RATE_LIMIT_SOURCE_PER_HOUR=30
INVITE_AUTH_RATE_LIMIT_RECIPIENT_PER_HOUR=6
INVITE_AUTH_RATE_LIMIT_SOURCE_PER_HOUR=30
